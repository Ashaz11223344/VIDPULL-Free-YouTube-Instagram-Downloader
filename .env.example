# Optional: URL of your deployed backend (e.g. on Render, Railway, or VPS).
# In local development, leave this empty to use Vite's internal proxy.
# Example: https://vidpull-backend.onrender.com
VITE_API_URL=

# Optional: Instagram session cookie to bypass cloud datacenter IP 429 rate limits on Render.
# To get this: Log in to instagram.com in browser -> Press F12 -> Application -> Cookies -> Copy "sessionid"
INSTAGRAM_SESSION_ID=
